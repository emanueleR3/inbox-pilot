### Automations API HTTP Tests
### Base URL
@baseUrl = http://localhost:8010

###############################################################################
### Health Check
###############################################################################

### GET Health Check
GET {{baseUrl}}/health
Accept: application/json

###############################################################################
### Agents - Main Routes
###############################################################################

### GET List of Available Agents
GET {{baseUrl}}/agents/
Accept: application/json

###############################################################################
### Agents - Calendar Routes
###############################################################################

### GET Calendar Agents
GET {{baseUrl}}/agents/calendars/
Accept: application/json

###############################################################################
### Agents - Email Routes
###############################################################################

### GET Email Agents
GET {{baseUrl}}/agents/emails/
Accept: application/json

###############################################################################
### Jerry Routes
###############################################################################

### GET Available Tools
GET {{baseUrl}}/jerry/tools
Accept: application/json

### POST Create New Thread
POST {{baseUrl}}/jerry/thread/create
Content-Type: application/json

{
	"user_id": "test_user_123"
}

### POST Send Message (New Thread)
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "Hello Jerry! Can you introduce yourself and tell me what you can do?"
}

### POST Send Message (Existing Thread)
# Note: Replace thread_id with actual value from previous response
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "What tools do you have access to?",
	"thread_id": "usertest_user_123:conv22d3ac87-effe-45fe-b3ca-be32a8c01516"
}

### POST Stream Message (New Thread)
POST {{baseUrl}}/jerry/message/stream
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "Tell me a detailed story about AI assistants helping humans"
}

### POST Stream Message (Existing Thread)
# Note: Replace thread_id with actual value
POST {{baseUrl}}/jerry/message/stream
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "Continue that story",
	"thread_id": "usertest_user_123:conv22d3ac87-effe-45fe-b3ca-be32a8c01516"
}

### GET Thread History
# Note: Replace thread_id with actual value
GET {{baseUrl}}/jerry/thread/usertest_user_123:conv22d3ac87-effe-45fe-b3ca-be32a8c01516/history
Accept: application/json

### DELETE Thread
# Note: Replace thread_id with actual value
DELETE {{baseUrl}}/jerry/thread/usertest_user_123:conv22d3ac87-effe-45fe-b3ca-be32a8c01516
Accept: application/json

### POST Execute Tool - Send Email
POST {{baseUrl}}/jerry/tool/execute
Content-Type: application/json

{
	"tool_name": "send_email",
	"tool_params": {
		"sender_address": "dev4@example.com",
		"receiver_address": "customer@example.com",
		"subject": "Test Email from Jerry API",
		"body": "This is a test email sent via the Jerry chatbot API tool execution endpoint.",
		"provider": "google",
		"body_type": "text"
	},
	"user_id": "test_user_123"
}

### POST Send Email via Natural Language
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "Send an email from dev4@example.com to customer@example.com with subject 'Meeting Reminder' and body 'Don't forget our meeting tomorrow at 10 AM.'"
}

### POST Complex Task - Multiple Emails
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"user_id": "test_user_123",
	"message": "I need to send two emails: First, send an email from dev4@example.com to customer@example.com with subject 'Update 1' and body 'This is the first update.' Then explain what you did."
}

### Jerry Error Handling Tests

### POST Message - Missing user_id
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"message": "Hello"
}

### POST Message - Missing message
POST {{baseUrl}}/jerry/message
Content-Type: application/json

{
	"user_id": "test_user_123"
}

### POST Execute Tool - Invalid Tool Name
POST {{baseUrl}}/jerry/tool/execute
Content-Type: application/json

{
	"tool_name": "non_existent_tool",
	"tool_params": {}
}

### POST Execute Tool - Missing Required Parameters
POST {{baseUrl}}/jerry/tool/execute
Content-Type: application/json

{
	"tool_name": "send_email",
	"tool_params": {
		"sender_address": "test@example.com"
	}
}

### GET History - Invalid Thread ID
GET {{baseUrl}}/jerry/thread/invalid_thread_id/history
Accept: application/json

### DELETE Thread - Invalid Thread ID
DELETE {{baseUrl}}/jerry/thread/invalid_thread_id
Accept: application/json

###############################################################################
### Quiz Routes
###############################################################################

### Start a quiz
POST {{baseUrl}}/internal-quiz/start
Content-Type: application/json

{
	"service_id": "b53b25ee-d52f-49b8-aee9-585bd55ecf27"
}

### Submit an answer
POST {{baseUrl}}/internal-quiz/answer
Content-Type: application/json

{
	"session_id": "7dd42f9c-8c4b-4beb-bad4-91f1db802dac",
	"value": "IDK, maybe Rome?"
}

### Get quiz state
GET {{baseUrl}}/internal-quiz/7dd42f9c-8c4b-4beb-bad4-91f1db802dac/state
Accept: application/json

### Finish quiz (force extraction)
POST {{baseUrl}}/internal-quiz/finish
Content-Type: application/json

{
	"session_id": "c181be4d-5fd1-4714-8f69-2c53bd889ec1"
}

### List all active quiz sessions
GET {{baseUrl}}/quiz/sessions
Accept: application/json

###############################################################################
### API Documentation
###############################################################################

### GET OpenAPI Schema
GET {{baseUrl}}/openapi.json
Accept: application/json

### GET Swagger UI Documentation
GET {{baseUrl}}/docs
Accept: text/html

### GET ReDoc Documentation
GET {{baseUrl}}/redoc
Accept: text/html

###############################################################################
### Error Handling Tests
###############################################################################

### GET Non-existent Route (404)
GET {{baseUrl}}/non-existent-route
Accept: application/json

### POST to GET-only endpoint (405)
POST {{baseUrl}}/health
Accept: application/json
