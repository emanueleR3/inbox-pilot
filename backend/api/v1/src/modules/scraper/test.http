### Scraper Module API Tests
### Base URL: http://localhost:8000/scraper

@baseUrl = http://localhost:8000/scraper
@email = business@example.com
@websiteUrl = https://www.villaimmacolata.eu
@maxUrls = 50

### ==============================================
### Discover URLs (User Selection)
### ==============================================

### Discover URLs for a website (research)
# @name researchUrls
POST {{baseUrl}}/research
Content-Type: application/json

{
    "website_url": "{{websiteUrl}}",
    "max_urls": {{maxUrls}}
}

### ==============================================
### Start Scraping Job (Selected URLs)
### ==============================================

### Start scraping - Basic request (selected URLs)
POST {{baseUrl}}/start
Content-Type: application/json

{
    "email": "{{email}}",
    "website_url": "{{websiteUrl}}",
    "urls": [
        "https://www.villaimmacolata.eu",
        "https://www.villaimmacolata.eu/rsa",
        "https://www.villaimmacolata.eu/sad-servizi-assistenziali-domiciliari"
    ]
}

### ==============================================
### Get Scraping Status
### ==============================================

### Check scraping job status
GET {{baseUrl}}/status/{{email}}

### Check status with different email
GET {{baseUrl}}/status/other@example.com

### ==============================================
### Get Collection Info
### ==============================================

### Get collection information
GET {{baseUrl}}/collection/{{email}}

### Get collection info for non-existent service
GET {{baseUrl}}/collection/unknown@example.com

### ==============================================
### Delete Collection
### ==============================================

### Delete the collection for a service
DELETE {{baseUrl}}/collection/{{email}}

### ==============================================
### Error Cases
### ==============================================

### Start scraping - Missing email
POST {{baseUrl}}/start
Content-Type: application/json

{
    "website_url": "{{websiteUrl}}",
    "urls": ["INSERIRE_URL_1"]
}

### Start scraping - Missing website_url
POST {{baseUrl}}/start
Content-Type: application/json

{
    "email": "{{email}}",
    "urls": ["INSERIRE_URL_1"]
}

### Start scraping - Missing urls
POST {{baseUrl}}/start
Content-Type: application/json

{
    "email": "{{email}}",
    "website_url": "{{websiteUrl}}"
}

### Start scraping - Empty urls array
POST {{baseUrl}}/start
Content-Type: application/json

{
    "email": "{{email}}",
    "website_url": "{{websiteUrl}}",
    "urls": []
}

### Research - Missing website_url
POST {{baseUrl}}/research
Content-Type: application/json

{
    "max_urls": 50
}

### ==============================================
### Full Workflow Test
### ==============================================

### Step 1: Research URLs
# @name wfResearch
POST {{baseUrl}}/research
Content-Type: application/json

{
    "website_url": "{{websiteUrl}}",
    "max_urls": {{maxUrls}}
}

### Step 2: Start scraping (paste selected URLs from wfResearch response)
# @name wfStartScraping
POST {{baseUrl}}/start
Content-Type: application/json

{
    "email": "{{email}}",
    "website_url": "{{websiteUrl}}",
    "urls": [
        "INSERIRE_URL_1",
        "INSERIRE_URL_2"
    ]
}

### Step 3: Check status (repeat until completed)
GET {{baseUrl}}/status/{{email}}

### Step 4: Get collection info
GET {{baseUrl}}/collection/{{email}}

### Step 5: (Optional) Delete collection
DELETE {{baseUrl}}/collection/{{email}}
