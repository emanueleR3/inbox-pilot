# Google Cloud OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_TOPIC_NAME=your-google-topic-name
GOOGLE_AUTH_URI=your-google-auth-uri
GOOGLE_TOKEN_URI=your-google-token-uri
GOOGLE_REDIRECT_URI=your-google-redirect-uri
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=your-google-auth-provider-x509-cert-url
GOOGLE_PUBSUB_TOPIC_PATH=your-google-pubsub-topic-path
GOOGLE_PUBSUB_SUBSCRIPTION_PATH=your-google-pubsub-subscription-path
GOOGLE_SCOPES=your-google-scopes
GOOGLE_APPLICATION_CREDENTIALS=your-google-application-credentials

# Microsoft OAuth2 Configuration
MICROSOFT_REDIRECT_URI=your-microsoft-redirect-uri
MICROSOFT_AUTHORITY=your-microsoft-authority
MICROSOFT_TOKEN_URL=your-microsoft-token-url
MICROSOFT_AUTH_URL=your-microsoft-auth-url
MICROSOFT_APPLICATION_ID_CLIENT=your-microsoft-application-id-client
MICROSOFT_OBJECT_ID=your-microsoft-object-id
MICROSOFT_DIRECTORY_ID_TENANT=your-microsoft-directory-id-tenant
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CLIENT_SECRET_VALUE=your-microsoft-client-value
MICROSOFT_SCOPES=your-microsoft-scopes 

# IMAP Poller settingsa
MAX_CONCURRENT_CONNECTIONS_IMAP=10
POLL_INTERVAL_MINUTES_IMAP=1            

# Listening URL for Microsoft Webhook (ngrok URL for local testing)
MICROSOFT_WEBHOOK_URL=your-microsoft-webhook-url

# Broker message queue (RabbitMQ)
RABBITMQ_URL=your-rabbitmq-url
RABBITMQ_VHOST=your-rabbitmq-vhost
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASS=your-rabbitmq-pass
QUEUE_NAME=your-queue-name

# Attachment storage path
ATTACHMENT_STORAGE_PATH=your-attachment-storage-path

# Number of hours between each subscription refresh check
#REFRESH_INTERVAL_HOURS_SUBSCRIPTIONS=3
REFRESH_INTERVAL_MINUTES_TOKENS=15
INITIAL_DELAY_SECONDS=30 # Delay before starting refreshers to allow listeners to be ready
CLEANUP_ORPHAN_SUBSCRIPTIONS=true

# Supabase configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_PASSWORD=your-supabase-password

# Redis configuration 
#REDIS_URL =
REDIS_PASSWORD=redispassword

# Chiave di cifratura per token
ENCRYPTION_KEY_TOKEN=encryption-key-token
ENCRYPTION_KEY_PASS=encryption-key-pass

AUTOMATION_API_URL=your-automation-api-url
SALT_LENGTH=your-salt-length
ENABLE_PROMPT_PROTECTION=true/false
OPENAI_API_KEY= your-openai-api-key

ENV = development # change to production in production environment

# LangSmith Configuration for tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=corretto-email-workflow